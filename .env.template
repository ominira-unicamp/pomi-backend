# Banco de Dados
DATABASE_URL="postgresql://postgres:senha@localhost:5432/pomi?schema=public"
POSTGRES_PASSWORD=senha
POSTGRES_DB=pomi
POSTGRES_USER=postgres
KC_DB_USERNAME=postgres
KC_DB_PASSWORD=senha
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=troque_esta_senha

# Servidores
POMI_DATA_PORT=3000
POMI_APP_PORT=3001
NODE_ENV=development

# Observabilidade (logs JSON no stdout; envio ao OpenObserve é opcional)
LOG_LEVEL=info
# OPENOBSERVE_URL=https://openobserve.example.com/api/organizacoes/pomi/streams
# OPENOBSERVE_AUTH=Basic token-ou-credencial
# OPENOBSERVE_STREAM=pomi-api-logs

# CORS
CORS_ORIGIN=*

# Opcional, desabilita autenticação somente em desenvolvimento
DISABLED_AUTH=true

# Keycloak
KEYCLOAK_ISSUER=http://localhost:8080/realms/pomi
KEYCLOAK_AUDIENCE=pomi-api

# Administração da POMI Data API
POMI_DATA_ADMIN_TOKEN=troque_esta_chave
