{
    "name": "pomi-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "license": "AGPL-3.0-only",
    "scripts": {
        "dev:data": "npm run dev --workspace @pomi/data",
        "dev:app": "npm run dev --workspace @pomi/app",
        "build": "npm run check:boundaries && npm run build --workspace @pomi/db && npm run build --workspace @pomi/api-core && npm run build --workspace @pomi/data && npm run build --workspace @pomi/app && npm run build --workspace @pomi/injection && npm run build --workspace @pomi/notifier",
        "check:boundaries": "node scripts/check-package-boundaries.mjs",
        "test": "npm run test --workspaces --if-present",
        "lint": "eslint packages/api-core/src packages/api-core/test packages/app/src packages/app/test packages/data/src packages/data/test packages/injection/src packages/injection/test packages/notifier/src packages/notifier/test packages/db/src packages/db/test --ext .ts && prettier --check \"packages/{api-core,app,data,injection,notifier}/{src,test,tests}/**/*.ts\" \"packages/db/{src,test}/**/*.ts\" \"packages/*/{package.json,tsconfig.json,tsconfig.test.json}\"",
        "injection:list": "npm run pomi-injection --workspace @pomi/injection -- list",
        "injection:validate": "npm run pomi-injection --workspace @pomi/injection -- validate",
        "injection:run": "npm run pomi-injection --workspace @pomi/injection -- run",
        "injection:watch": "npm run pomi-injection --workspace @pomi/injection -- watch",
        "injection:request": "npm run pomi-injection --workspace @pomi/injection -- request",
        "injection:job-status": "npm run pomi-injection --workspace @pomi/injection -- job-status",
        "notifier:request": "npm run pomi-notifier --workspace @pomi/notifier -- request",
        "notifier:job-status": "npm run pomi-notifier --workspace @pomi/notifier -- job-status",
        "auth:bootstrap-admin": "npm run auth:bootstrap-admin --workspace @pomi/app",
        "prisma:generate": "npm run generate --workspace @pomi/db",
        "db:sync-academic-position-catalog": "npm run sync:academic-position-catalog --workspace @pomi/db",
        "prisma:migrate:dev": "npm run migrate:dev --workspace @pomi/db",
        "prisma:deploy": "npm run migrate:deploy --workspace @pomi/db",
        "prisma:status": "npm run migrate:status --workspace @pomi/db",
        "prepare": "husky install"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/express": "5.0.5",
        "@types/node": "22.18.12",
        "@types/pg": "^8.15.6",
        "@types/swagger-ui-express": "^4.1.8",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.2.7",
        "prettier": "3.8.0",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prisma": "^7.2.0",
        "prisma-dbml-generator": "^0.12.0",
        "prisma-zod-generator": "^2.1.2",
        "tsx": "^4.20.6",
        "typescript": "5.8.2",
        "typescript-eslint": "^8.53.0"
    },
    "overrides": {
        "hono": "^4.11.4",
        "@prisma/generator-helper": "^7.2.0",
        "@prisma/internals": "^7.2.0",
        "jsonwebtoken": "8.5.1"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "eslint --cache",
            "prettier --write"
        ]
    },
    "allowScripts": {
        "@prisma/engines@7.8.0": true,
        "@scarf/scarf@1.4.0": true,
        "esbuild@0.28.0": true,
        "prisma@7.8.0": true,
        "prisma-zod-generator@2.1.4": true
    }
}
