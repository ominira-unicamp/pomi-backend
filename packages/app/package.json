{
    "name": "@pomi/app",
    "version": "1.0.0-rc.1",
    "private": true,
    "type": "module",
    "imports": {
        "#/*": {
            "development": "./src/*",
            "default": "./dist/src/*"
        }
    },
    "scripts": {
        "dev": "NODE_OPTIONS=--conditions=development tsx watch --import @pomi/api-core/telemetry/bootstrap src/index.ts",
        "build": "tsc -b",
        "start": "node --import @pomi/api-core/telemetry/bootstrap dist/src/index.js",
        "test": "NODE_OPTIONS=--conditions=development tsx --test test/**/*.test.ts",
        "openapi:export": "NODE_OPTIONS=--conditions=development tsx scripts/exportOpenApi.ts",
        "auth:bootstrap-admin": "NODE_OPTIONS=--conditions=development tsx src/bootstrap-admin.ts"
    },
    "dependencies": {
        "@asteasolutions/zod-to-openapi": "^8.2.0",
        "@pomi/api-core": "*",
        "@pomi/db": "*",
        "@scalar/express-api-reference": "^0.8.30",
        "awilix": "^13.0.5",
        "cors": "^2.8.5",
        "dotenv": "^17.2.3",
        "express": "5.1.0",
        "helmet": "^8.1.0",
        "jose": "^6.1.3",
        "path-to-regexp": "^8.3.0",
        "swagger-ui-express": "^5.0.1",
        "zod": "^4.2.1"
    }
}
