generator client {
  provider            = "prisma-client"
  output              = "./generated"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "./generated/zod"
  config   = "./config-zod.json"
}

datasource db {
  provider = "postgresql"
  schemas  = ["data", "app", "unicamp_data_portal"]
}

enum YearPeriods {
  SUMMER
  FIRST_SEMESTER
  WINTER
  SECOND_SEMESTER

  @@schema("data")
}

enum CourseOfferingPeriod {
  ALL_PERIODS
  ODD_PERIODS
  EVEN_PERIODS
  UNIT_DISCRETION

  @@schema("data")
}

enum CourseEvaluationMode {
  GRADE_AND_ATTENDANCE
  CONCEPT
  ATTENDANCE

  @@schema("data")
}

enum CatalogCoursePrerequisiteFulfillment {
  FULL
  PARTIAL

  @@schema("data")
}

enum CatalogCourseSpecialRequirementType {
  AUTHORIZATION
  PROGRESSION_COEFFICIENT

  @@schema("data")
}

enum AcademicRole {
  PROFESSOR
  RESEARCHER
  POSTDOCTORAL_RESEARCHER

  @@map("data_portal_academic_role")
  @@schema("unicamp_data_portal")
}

enum AcademicAffiliationType {
  CAREER
  COLLABORATOR
  SENIOR
  VISITING_INVITED
  VISITING_SPECIALIST
  POSTDOCTORAL_PROGRAM

  @@map("data_portal_academic_affiliation_type")
  @@schema("unicamp_data_portal")
}

enum AcademicCareer {
  MS
  MA
  MTS
  MST
  DEL
  DEER
  PQ

  @@map("data_portal_academic_career")
  @@schema("unicamp_data_portal")
}

enum AcademicPostdoctoralModality {
  STANDARD
  OM

  @@map("data_portal_academic_postdoctoral_modality")
  @@schema("unicamp_data_portal")
}

enum IdentifierSystem {
  LATTES
  ORCID
  SCOPUS
  WEB_OF_SCIENCE
  PUBLONS
  GOOGLE_SCHOLAR
  SCIELO
  FAPESP

  @@map("data_portal_identifier_system")
  @@schema("unicamp_data_portal")
}

enum TrainingDegree {
  POST_DOCTORATE
  DOCTORATE
  MASTER
  UNDERGRADUATE

  @@map("data_portal_training_degree")
  @@schema("unicamp_data_portal")
}

enum PeriodPlanningGuideMode {
  CURRICULUM
  PROGRAM
  NONE

  @@schema("app")
}

enum PeriodPlanningCurriculumSource {
  SAVED
  SUGGESTION

  @@schema("app")
}

enum AuthUserStatus {
  ACTIVE
  DISABLED

  @@schema("app")
}

enum AuthRole {
  STUDENT
  BOT
  ADMIN

  @@schema("app")
}

enum Capability {
  ACADEMIC_WRITE

  @@schema("app")
}

enum StudentCapability {
  STUDENT_PROFILE_READ
  STUDENT_PROFILE_WRITE
  STUDENT_HISTORY_READ
  STUDENT_HISTORY_WRITE
  STUDENT_PLANNING_READ
  STUDENT_PLANNING_WRITE
  STUDENT_SOCIAL_READ
  STUDENT_SOCIAL_WRITE
  STUDENT_FEEDBACK_WRITE
  STUDENT_FEEDBACK_READ

  @@schema("app")
}

enum StudentFriendshipStatus {
  PENDING
  ACCEPTED

  @@schema("app")
}

enum PeriodPlanningVisibility {
  PRIVATE
  FRIENDS
  PUBLIC

  @@schema("app")
}

enum FeedbackReportKind {
  BUG
  SUGGESTION
  DATA_ISSUE

  @@schema("app")
}

enum FeedbackReportTargetType {
  GENERAL
  FEATURE
  ACADEMIC_RESOURCE

  @@schema("app")
}

enum FeedbackReportStatus {
  OPEN
  IN_PROGRESS
  CLOSED

  @@schema("app")
}

enum ExchangeNoticeDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  FAILED

  @@schema("app")
}

enum JobRequestType {
  INJECTION
  NOTIFIER

  @@schema("app")
}

enum JobRequestStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED

  @@schema("app")
}

enum JobRequestTrigger {
  SCHEDULED
  MANUAL

  @@schema("app")
}

enum DataSnapshotStatus {
  COLLECTING
  VALIDATED
  PERSISTING
  PUBLISHED
  INVALID
  FAILED

  @@schema("app")
}

enum DataSnapshotComponentStatus {
  COMPLETE
  UNAVAILABLE
  FAILED
  PERSISTED

  @@schema("app")
}

model AuthUser {
  id          Int            @id @default(autoincrement())
  issuer      String
  subject     String
  email       String?
  displayName String?
  status      AuthUserStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  roles         AuthUserRole[]
  capabilities  AuthUserCapability[]
  student       Student?             @relation("AuthUserStudent", fields: [studentId], references: [id], onDelete: SetNull)
  studentId     Int?
  botGrants     BotGrant[]           @relation("BotGrantBot")
  grantsGiven   BotGrant[]           @relation("BotGrantGrantedBy")
  grantsRevoked BotGrant[]           @relation("BotGrantRevokedBy")

  @@unique([issuer, subject])
  @@index([studentId])
  @@schema("app")
}

model JobRequest {
  id               String            @id @default(uuid())
  type             JobRequestType
  name             String
  parentJobId      String?
  partitionKey     String?
  parameters       Json?
  mode             String?
  status           JobRequestStatus  @default(QUEUED)
  trigger          JobRequestTrigger
  availableAt      DateTime          @default(now())
  scheduledFor     DateTime?
  deduplicationKey String?           @unique
  requestedBy      String?
  runId            String?
  startedAt        DateTime?
  finishedAt       DateTime?
  errorMessage     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  parent     JobRequest?    @relation("JobRequestPartitions", fields: [parentJobId], references: [id], onDelete: SetNull)
  partitions JobRequest[]   @relation("JobRequestPartitions")
  snapshots  DataSnapshot[]

  @@index([type, status, availableAt])
  @@index([type, name, status])
  @@index([type, name, partitionKey, status])
  @@schema("app")
}

model DataSnapshot {
  id              String             @id
  protocol        String
  protocolVersion Int
  workflow        String
  partitionKey    String
  profile         String
  status          DataSnapshotStatus @default(COLLECTING)
  manifestPath    String
  manifestSha256  String?
  producer        Json?
  jobRequestId    String?
  collectedAt     DateTime?
  validatedAt     DateTime?
  persistedAt     DateTime?
  publishedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  jobRequest JobRequest?             @relation(fields: [jobRequestId], references: [id], onDelete: SetNull)
  components DataSnapshotComponent[]

  @@index([workflow, partitionKey, status])
  @@index([jobRequestId])
  @@schema("app")
}

model DataSnapshotComponent {
  id             Int                         @id @default(autoincrement())
  snapshotId     String
  name           String
  schemaVersion  Int
  status         DataSnapshotComponentStatus
  artifactPath   String?
  artifactSha256 String?
  recordCount    Int?
  issueCount     Int                         @default(0)
  persistedAt    DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  snapshot DataSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, name])
  @@index([status])
  @@schema("app")
}

model AuthUserRole {
  authUser   AuthUser @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  authUserId Int
  role       AuthRole

  @@id([authUserId, role])
  @@schema("app")
}

model AuthUserCapability {
  authUser   AuthUser   @relation(fields: [authUserId], references: [id], onDelete: Cascade)
  authUserId Int
  capability Capability

  @@id([authUserId, capability])
  @@schema("app")
}

// ----------------------- Academic Models ----------------------- //

model Unit {
  id                          Int                          @id @default(autoincrement())
  code                        String                       @unique
  name                        String
  courses                     Course[]
  programs                    Program[]
  departments                 Department[]
  professorDataPortalProfiles ProfessorDataPortalProfile[]

  @@schema("data")
}

model Department {
  id     Int    @id @default(autoincrement())
  name   String
  unitId Int

  unit     Unit                         @relation(fields: [unitId], references: [id])
  profiles ProfessorDataPortalProfile[]

  @@unique([unitId, name])
  @@schema("data")
}

model Coordinator {
  id   Int    @id @default(autoincrement())
  name String @unique

  catalogCourses CatalogCourse[]

  @@schema("data")
}

model Course {
  id      Int    @id @default(autoincrement())
  code    String @unique
  name    String
  credits Int
  unit    Unit?  @relation(fields: [unitId], references: [id])
  unitId  Int?

  classes                     Class[]
  catalogCourses              CatalogCourse[]
  studentCourseAttempts       StudentCourseAttempt[]
  curriculumCourses           CurriculumCourse[]
  courseRequirements          CourseRequirement[]
  suggestionCourses           SuggestionCourse[]
  periodPlanningManualCourses PeriodPlanningManualCourse[]
  catalogPrerequisiteItems    CatalogCoursePrerequisiteItem[]
  courseTags                  CourseTag[]

  @@index([unitId])
  @@schema("data")
}

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique

  tags Tag[]

  @@schema("app")
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String

  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId Int

  parent      Tag?  @relation("TagHierarchy", fields: [parentTagId], references: [id], onDelete: Restrict)
  parentTagId Int?
  children    Tag[] @relation("TagHierarchy")

  courseTags       CourseTag[]
  studentInterests StudentTagInterest[]

  @@unique([categoryId, name])
  @@index([parentTagId])
  @@schema("app")
}

model CourseTag {
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  courseId Int
  tag      Tag    @relation(fields: [tagId], references: [id], onDelete: Restrict)
  tagId    Int

  @@id([courseId, tagId])
  @@index([tagId])
  @@schema("app")
}

model StudentTagInterest {
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId Int

  tag   Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId Int

  createdAt DateTime @default(now())

  @@id([studentId, tagId])
  @@index([tagId])
  @@schema("app")
}

// ----------------------- Programs Catalog Models ----------------------- //

model Catalog {
  id       Int              @id @default(autoincrement())
  year     Int              @unique
  programs CatalogProgram[]
  courses  CatalogCourse[]

  students Student[]

  @@schema("data")
}

model CatalogCourse {
  id Int @id @default(autoincrement())

  catalog   Catalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  catalogId Int

  course   Course @relation(fields: [courseId], references: [id])
  courseId Int

  name          String
  coordinator   Coordinator? @relation(fields: [coordinatorId], references: [id])
  coordinatorId Int?

  theoreticalHours        Int?
  practicalHours          Int?
  laboratoryHours         Int?
  guidedActivityHours     Int?
  distanceHours           Int?
  guidedExtensionHours    Int?
  practicalExtensionHours Int?
  weeks                   Int?
  weeklyClassHours        Int?
  classroomHours          Int?

  offeringPeriod           CourseOfferingPeriod?
  evaluation               CourseEvaluationMode?
  finalExam                Boolean?
  minimumAttendancePercent Int?

  syllabus     String? @db.Text
  bibliography String? @db.Text
  sourceUrl    String?

  prerequisites CatalogCoursePrerequisiteGroup[]

  @@unique([catalogId, courseId])
  @@index([courseId])
  @@schema("data")
}

model CatalogCoursePrerequisiteGroup {
  id              Int           @id @default(autoincrement())
  catalogCourse   CatalogCourse @relation(fields: [catalogCourseId], references: [id], onDelete: Cascade)
  catalogCourseId Int

  items CatalogCoursePrerequisiteItem[]

  @@schema("data")
}

model CatalogCoursePrerequisiteItem {
  id      Int                            @id @default(autoincrement())
  group   CatalogCoursePrerequisiteGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId Int

  courseId    Int?
  fulfillment CatalogCoursePrerequisiteFulfillment?

  specialRequirementType  CatalogCourseSpecialRequirementType?
  specialRequirementValue Int?

  course Course? @relation(fields: [courseId], references: [id])

  @@schema("data")
}

model Program {
  id                     Int                     @id @default(autoincrement())
  code                   Int                     @unique
  name                   String
  unit                   Unit                    @relation(fields: [unitId], references: [id])
  unitId                 Int
  catalogPrograms        CatalogProgram[]
  catalogProgramVariants CatalogProgramVariant[]
  specializations        Specialization[]
  students               Student[]
  classReservations      ClassReservation[]

  @@schema("data")
}

model Specialization {
  id        Int       @id @default(autoincrement())
  program   Program   @relation(fields: [programId], references: [id])
  programId Int
  code      String
  name      String
  students  Student[]

  catalogProgramVariants CatalogProgramVariant[]

  @@unique([programId, code])
  @@schema("data")
}

model Language {
  id               Int               @id @default(autoincrement())
  name             String
  catalogLanguages CatalogLanguage[]
  periodPlannings  PeriodPlanning[]
  students         Student[]

  @@schema("data")
}

model CatalogProgram {
  id                                Int                     @id @default(autoincrement())
  catalog                           Catalog                 @relation(fields: [catalogId], references: [id])
  catalogId                         Int
  program                           Program                 @relation(fields: [programId], references: [id])
  programId                         Int
  shift                             CatalogProgramShift?
  creditLimitType                   CatalogCreditLimitType?
  creditLimitFixedCredits           Int?
  creditLimitBeforeThresholdCredits Int?
  creditLimitThresholdCredits       Int?
  creditLimitCrBase                 Int?
  creditLimitCrMultiplier           Float?
  professionalPracticeDescription   String?                 @db.Text
  variants                          CatalogProgramVariant[]
  catalogLanguages                  CatalogLanguage[]
  courseBlocks                      CourseBlock[]
  curricula                         Curriculum[]
  periodPlannings                   PeriodPlanning[]

  @@unique([catalogId, programId])
  @@schema("data")
}

enum CatalogProgramShift {
  DAYTIME
  NIGHT

  @@schema("data")
}

enum CatalogCreditLimitType {
  NONE
  FIXED
  CR_FORMULA

  @@schema("data")
}

model CatalogLanguage {
  id               Int            @id @default(autoincrement())
  catalogProgram   CatalogProgram @relation(fields: [catalogProgramId], references: [id], onDelete: Cascade)
  catalogProgramId Int
  language         Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)
  languageId       Int
  courseBlocks     CourseBlock[]
  curricula        Curriculum[]

  @@unique([catalogProgramId, languageId])
  @@schema("data")
}

model CurriculumSuggestion {
  id                      Int                   @id @default(autoincrement())
  catalogProgramVariant   CatalogProgramVariant @relation(fields: [catalogProgramVariantId], references: [id], onDelete: Cascade)
  catalogProgramVariantId Int                   @unique
  semesters               SemesterSuggestion[]
  periodPlannings         PeriodPlanning[]

  @@schema("data")
}

model CatalogProgramVariant {
  id               Int             @id @default(autoincrement())
  catalogProgram   CatalogProgram  @relation(fields: [catalogProgramId], references: [id], onDelete: Cascade)
  catalogProgramId Int
  program          Program?        @relation(fields: [programId], references: [id])
  programId        Int?
  specialization   Specialization? @relation(fields: [specializationId], references: [id])
  specializationId Int?

  integralizationCredits          Int?
  integralizationSupervisedHours  Int?
  integralizationExtensionHours   Int?
  integralizationSemesters        Int?
  integralizationMaximumSemesters Int?
  professionalDescription         String? @db.Text
  recognitionDescription          String? @db.Text

  courseBlocks         CourseBlock[]
  curriculumSuggestion CurriculumSuggestion?
  curricula            Curriculum[]
  periodPlannings      PeriodPlanning[]

  @@unique([catalogProgramId, programId])
  @@unique([catalogProgramId, specializationId])
  @@index([programId])
  @@index([specializationId])
  @@schema("data")
}

model SemesterSuggestion {
  id              Int                  @id @default(autoincrement())
  suggestion      CurriculumSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  suggestionId    Int
  semester        Int
  electiveCredits Int                  @default(0)
  courses         SuggestionCourse[]

  @@unique([suggestionId, semester])
  @@schema("data")
}

model SuggestionCourse {
  id                   Int                @id @default(autoincrement())
  semesterSuggestion   SemesterSuggestion @relation(fields: [semesterSuggestionId], references: [id], onDelete: Cascade)
  semesterSuggestionId Int
  course               Course             @relation(fields: [courseId], references: [id])
  courseId             Int

  @@unique([semesterSuggestionId, courseId])
  @@schema("data")
}

// ----------------------- Course Requirements Models ----------------------- //

enum CourseBlockType {
  mandatory
  elective

  @@schema("data")
}

enum CourseRequirementType {
  any
  prefix
  specific

  @@schema("data")
}

enum DataAuditOperation {
  CREATE
  UPDATE
  DELETE

  @@schema("data")
}

model CourseBlock {
  id      Int             @id @default(autoincrement())
  type    CourseBlockType
  credits Int?

  catalogLanguage   CatalogLanguage? @relation(fields: [catalogLanguageId], references: [id], onDelete: Cascade)
  catalogLanguageId Int?

  catalogProgramVariant   CatalogProgramVariant? @relation(fields: [catalogProgramVariantId], references: [id], onDelete: Cascade)
  catalogProgramVariantId Int?

  catalogProgram   CatalogProgram? @relation(fields: [catalogProgramId], references: [id], onDelete: Cascade)
  catalogProgramId Int?

  courseRequirements CourseRequirement[]

  @@schema("data")
}

model CourseRequirement {
  id            Int                   @id @default(autoincrement())
  courseBlock   CourseBlock           @relation(fields: [courseBlockId], references: [id], onDelete: Cascade)
  courseBlockId Int
  type          CourseRequirementType
  course        Course?               @relation(fields: [courseId], references: [id])
  courseId      Int?
  prefix        String?

  @@index([courseBlockId])
  @@schema("data")
}

model DataAuditEvent {
  id            BigInt             @id @default(autoincrement())
  schemaName    String             @db.VarChar(63)
  tableName     String             @db.VarChar(63)
  recordKey     Json
  operation     DataAuditOperation
  before        Json?
  after         Json?
  auditContext  Json?
  runId         String?            @db.Uuid
  injectionName String?            @db.VarChar(100)
  transactionId BigInt
  occurredAt    DateTime           @default(now())

  @@index([schemaName, tableName, occurredAt])
  @@index([runId, occurredAt])
  @@schema("data")
}

// ----------------------- Timetable Booklet Models ----------------------- //

model StudyPeriod {
  id                    Int                    @id @default(autoincrement())
  year                  Int
  yearPeriod            YearPeriods
  startDate             DateTime
  classes               Class[]
  periodPlannings       PeriodPlanning[]
  studentCourseAttempts StudentCourseAttempt[]

  @@unique([year, yearPeriod])
  @@index([year])
  @@schema("data")
}

model Professor {
  id                   Int                         @id @default(autoincrement())
  name                 String
  classes              Class[]
  professorEvaluations ProfessorEvaluation[]
  dataPortalProfile    ProfessorDataPortalProfile?

  @@schema("data")
}

model ProfessorDataPortalProfile {
  id             Int     @id @default(autoincrement())
  professorId    Int     @unique
  portalId       Int     @unique
  name           String
  email          String?
  lattesAbstract String?
  unitId         Int
  departmentId   Int?
  positionId     Int?

  professor     Professor                   @relation(fields: [professorId], references: [id])
  unit          Unit                        @relation(fields: [unitId], references: [id])
  department    Department?                 @relation(fields: [departmentId], references: [id])
  position      AcademicPosition?           @relation(fields: [positionId], references: [id])
  identities    ProfessorExternalIdentity[]
  citationNames ProfessorCitationName[]
  trainings     ProfessorTraining[]
  keywords      ProfessorKeyword[]
  coauthors     ProfessorCoauthor[]

  @@index([unitId])
  @@index([departmentId])
  @@index([positionId])
  @@map("data_portal_professor_profile")
  @@schema("unicamp_data_portal")
}

model AcademicCareerReference {
  id               Int                @id @default(autoincrement())
  career           AcademicCareer
  code             String
  rank             String?
  category         String?
  progressionOrder Int
  active           Boolean            @default(true)
  positions        AcademicPosition[]

  @@unique([career, code])
  @@map("data_portal_academic_career_reference")
  @@schema("unicamp_data_portal")
}

model AcademicPosition {
  id                   Int                           @id @default(autoincrement())
  canonicalKey         String                        @unique
  role                 AcademicRole
  affiliationType      AcademicAffiliationType
  careerReferenceId    Int?
  postdoctoralModality AcademicPostdoctoralModality?
  programCode          String?
  careerReference      AcademicCareerReference?      @relation(fields: [careerReferenceId], references: [id])
  profiles             ProfessorDataPortalProfile[]

  @@map("data_portal_position")
  @@schema("unicamp_data_portal")
}

model ProfessorExternalIdentity {
  id         Int              @id @default(autoincrement())
  profileId  Int
  system     IdentifierSystem
  externalId String

  profile ProfessorDataPortalProfile @relation(fields: [profileId], references: [id])

  @@unique([profileId, system, externalId])
  @@index([system, externalId])
  @@map("data_portal_external_identity")
  @@schema("unicamp_data_portal")
}

model ProfessorCitationName {
  id        Int    @id @default(autoincrement())
  profileId Int
  name      String

  profile ProfessorDataPortalProfile @relation(fields: [profileId], references: [id])

  @@unique([profileId, name])
  @@map("data_portal_citation_name")
  @@schema("unicamp_data_portal")
}

model ProfessorTraining {
  id              Int            @id @default(autoincrement())
  profileId       Int
  degree          TrainingDegree
  institutionName String
  startYear       Int?
  endYear         Int?

  profile ProfessorDataPortalProfile @relation(fields: [profileId], references: [id])

  @@index([profileId])
  @@map("data_portal_training")
  @@schema("unicamp_data_portal")
}

model Keyword {
  id             Int    @id @default(autoincrement())
  name           String
  normalizedName String @unique

  profiles ProfessorKeyword[]

  @@map("data_portal_keyword")
  @@schema("unicamp_data_portal")
}

model ProfessorKeyword {
  profileId Int
  keywordId Int
  count     Int?

  profile ProfessorDataPortalProfile @relation(fields: [profileId], references: [id])
  keyword Keyword                    @relation(fields: [keywordId], references: [id])

  @@id([profileId, keywordId])
  @@map("data_portal_professor_keyword")
  @@schema("unicamp_data_portal")
}

model Coauthor {
  id             Int    @id @default(autoincrement())
  name           String
  normalizedName String @unique

  profiles ProfessorCoauthor[]

  @@map("data_portal_coauthor")
  @@schema("unicamp_data_portal")
}

model ProfessorCoauthor {
  profileId  Int
  coauthorId Int
  count      Int?

  profile  ProfessorDataPortalProfile @relation(fields: [profileId], references: [id])
  coauthor Coauthor                   @relation(fields: [coauthorId], references: [id])

  @@id([profileId, coauthorId])
  @@map("data_portal_professor_coauthor")
  @@schema("unicamp_data_portal")
}

model Room {
  id             Int             @id @default(autoincrement())
  code           String          @unique
  classSchedules ClassSchedule[]

  @@schema("data")
}

model Class {
  id                    Int                    @id @default(autoincrement())
  code                  String
  studyPeriod           StudyPeriod            @relation(fields: [studyPeriodId], references: [id])
  studyPeriodId         Int
  course                Course                 @relation(fields: [courseId], references: [id])
  courseId              Int
  professors            Professor[]
  classSchedules        ClassSchedule[]
  periodPlannings       PeriodPlanning[]
  studentCourseAttempts StudentCourseAttempt[]
  professorEvaluations  ProfessorEvaluation[]
  reservationPrograms   ClassReservation[]

  @@index([courseId])
  @@index([studyPeriodId])
  @@schema("data")
}

model ClassReservation {
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId   Int
  program   Program @relation(fields: [programId], references: [id], onDelete: Restrict)
  programId Int

  @@id([classId, programId])
  @@index([programId])
  @@schema("data")
}

//  Sim é um Enum para dias das semanas, não é melhor coisa, mas quis assim. 
enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@schema("data")
}

model ClassSchedule {
  id        Int       @id @default(autoincrement())
  dayOfWeek DayOfWeek
  start     String
  end       String
  room      Room      @relation(fields: [roomId], references: [id])
  roomId    Int
  class     Class     @relation(fields: [classId], references: [id])
  classId   Int

  studentAbsences StudentAbsence[]

  @@index([classId])
  @@index([roomId])
  @@schema("data")
}

// ----------------------- Restaurant & Menu Models ----------------------- //

enum MealPeriod {
  LUNCH
  DINNER

  @@schema("data")
}

enum DietaryOption {
  TRADITIONAL
  VEGAN

  @@schema("data")
}

enum MealStatus {
  AVAILABLE
  NOT_REGISTERED

  @@schema("data")
}

model DailyMenu {
  id   Int      @id @default(autoincrement())
  date DateTime @unique @db.Date

  meals Meal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("data")
}

model Meal {
  id          Int       @id @default(autoincrement())
  dailyMenu   DailyMenu @relation(fields: [dailyMenuId], references: [id], onDelete: Cascade)
  dailyMenuId Int

  period MealPeriod
  diet   DietaryOption
  status MealStatus

  mainDish String?

  items        MealItem[]
  observations MealObservation[]
  serviceNotes MealServiceNote[]

  @@unique([dailyMenuId, period, diet])
  @@schema("data")
}

model MealItem {
  id     Int    @id @default(autoincrement())
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealId Int
  text   String

  @@schema("data")
}

model MealObservation {
  id     Int    @id @default(autoincrement())
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealId Int
  text   String

  @@schema("data")
}

model MealServiceNote {
  id     Int    @id @default(autoincrement())
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)
  mealId Int
  text   String

  @@unique([mealId, text])
  @@schema("data")
}

model ExchangeNotice {
  id         Int     @id @default(autoincrement())
  naturalKey String  @unique
  number     String?
  issuer     String?
  title      String?

  placeId Int?
  place   ExchangePlace? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  registrationOriginalText String?
  registrationStart        DateTime?
  registrationEnd          DateTime?

  files      ExchangeNoticeFile[]
  deliveries ExchangeNoticeDelivery[]

  @@schema("data")
}

model ExchangeNoticeFile {
  id             Int     @id @default(autoincrement())
  name           String
  normalizedName String
  url            String?

  noticeId Int
  notice   ExchangeNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([noticeId, normalizedName])
  @@schema("data")
}

model ExchangePlace {
  id             Int    @id @default(autoincrement())
  name           String
  normalizedName String @unique

  notices                  ExchangeNotice[]
  noticeSubscriptionPlaces ExchangeNoticeSubscriptionPlace[]

  @@schema("data")
}

// ----------------------- Student Models ----------------------- //

enum StudentCourseAttemptStatus {
  ENROLLED
  DROPPED
  APPROVED
  FAILED_BY_GRADE
  APPROVED_BY_ATTENDANCE
  APPROVED_BY_PROFICIENCY
  FAILED_BY_ATTENDANCE
  SUFFICIENT
  INSUFFICIENT

  @@schema("app")
}

enum StudentCurrentCoursesVisibility {
  PRIVATE
  FRIENDS
  PUBLIC

  @@schema("app")
}

model Student {
  id                       Int                             @id @default(autoincrement())
  ra                       String                          @unique
  name                     String
  authUsers                AuthUser[]                      @relation("AuthUserStudent")
  program                  Program?                        @relation(fields: [programId], references: [id])
  programId                Int?
  specialization           Specialization?                 @relation(fields: [specializationId], references: [id])
  specializationId         Int?
  catalog                  Catalog?                        @relation(fields: [catalogId], references: [id])
  catalogId                Int?
  entryYear                Int?
  language                 Language?                       @relation(fields: [languageId], references: [id])
  languageId               Int?
  publicId                 String                          @unique @default(dbgenerated("gen_random_uuid()"))
  publicProfileEnabled     Boolean                         @default(false)
  publicDisplayName        String?                         @db.VarChar(80)
  publicBio                String?                         @db.VarChar(280)
  currentCoursesVisibility StudentCurrentCoursesVisibility @default(PRIVATE)

  courseAttempts             StudentCourseAttempt[]
  professorEvaluations       ProfessorEvaluation[]
  periodPlannings            PeriodPlanning[]
  curriculums                Curriculum[]
  favoriteCurriculum         Curriculum?                 @relation("StudentFavoriteCurriculum", fields: [favoriteCurriculumId], references: [id], onDelete: SetNull)
  favoriteCurriculumId       Int?                        @unique
  botGrants                  BotGrant[]
  friendshipsAsA             StudentFriendship[]         @relation("StudentFriendshipsAsA")
  friendshipsAsB             StudentFriendship[]         @relation("StudentFriendshipsAsB")
  friendshipRequests         StudentFriendship[]         @relation("StudentFriendshipRequester")
  feedbackReports            FeedbackReport[]
  exchangeNoticeSubscription ExchangeNoticeSubscription?
  exchangeNoticeDeliveries   ExchangeNoticeDelivery[]
  tagInterests               StudentTagInterest[]

  @@schema("app")
}

model ExchangeNoticeSubscription {
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId Int     @id

  enabled Boolean @default(false)

  places    ExchangeNoticeSubscriptionPlace[]
  createdAt DateTime                          @default(now())
  updatedAt DateTime                          @updatedAt

  @@schema("app")
}

model ExchangeNoticeSubscriptionPlace {
  subscription          ExchangeNoticeSubscription @relation(fields: [subscriptionStudentId], references: [studentId], onDelete: Cascade)
  subscriptionStudentId Int

  place   ExchangePlace @relation(fields: [placeId], references: [id], onDelete: Cascade)
  placeId Int

  @@id([subscriptionStudentId, placeId])
  @@schema("app")
}

model ExchangeNoticeDelivery {
  id Int @id @default(autoincrement())

  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId Int

  notice   ExchangeNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  noticeId Int

  status        ExchangeNoticeDeliveryStatus @default(PENDING)
  attemptCount  Int                          @default(0)
  nextAttemptAt DateTime                     @default(now())
  processingAt  DateTime?
  sentAt        DateTime?
  lastError     String?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  @@unique([studentId, noticeId])
  @@index([status, nextAttemptAt])
  @@schema("app")
}

model FeedbackReport {
  id Int @id @default(autoincrement())

  kind       FeedbackReportKind
  targetType FeedbackReportTargetType
  featureKey String?                  @db.VarChar(64)

  academicResourceType String? @db.VarChar(64)
  academicResourceId   Int?

  title        String               @db.VarChar(160)
  description  String
  sourcePath   String?              @db.VarChar(300)
  status       FeedbackReportStatus @default(OPEN)
  adminMessage String?              @db.Text

  reporterStudent   Student? @relation(fields: [reporterStudentId], references: [id], onDelete: SetNull)
  reporterStudentId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([reporterStudentId])
  @@index([academicResourceType, academicResourceId])
  @@schema("app")
}

model StudentFriendship {
  id            Int                     @id @default(autoincrement())
  studentA      Student                 @relation("StudentFriendshipsAsA", fields: [studentAId], references: [id], onDelete: Cascade)
  studentAId    Int
  studentB      Student                 @relation("StudentFriendshipsAsB", fields: [studentBId], references: [id], onDelete: Cascade)
  studentBId    Int
  requestedBy   Student                 @relation("StudentFriendshipRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  requestedById Int
  status        StudentFriendshipStatus @default(PENDING)
  acceptedAt    DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([studentAId, studentBId])
  @@index([studentAId, status])
  @@index([studentBId, status])
  @@index([requestedById, status])
  @@schema("app")
}

model BotGrant {
  id                  Int               @id @default(autoincrement())
  student             Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId           Int
  botAuthUser         AuthUser          @relation("BotGrantBot", fields: [botAuthUserId], references: [id], onDelete: Cascade)
  botAuthUserId       Int
  capability          StudentCapability
  grantedByAuthUser   AuthUser          @relation("BotGrantGrantedBy", fields: [grantedByAuthUserId], references: [id])
  grantedByAuthUserId Int
  createdAt           DateTime          @default(now())
  revokedAt           DateTime?
  revokedByAuthUser   AuthUser?         @relation("BotGrantRevokedBy", fields: [revokedByAuthUserId], references: [id])
  revokedByAuthUserId Int?

  @@index([studentId, botAuthUserId, capability, revokedAt])
  @@schema("app")
}

model StudentCourseAttempt {
  id             Int                        @id @default(autoincrement())
  student        Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId      Int
  course         Course                     @relation(fields: [courseId], references: [id])
  courseId       Int
  studyPeriod    StudyPeriod?               @relation(fields: [studyPeriodId], references: [id])
  studyPeriodId  Int?
  class          Class?                     @relation(fields: [classId], references: [id], onDelete: SetNull)
  classId        Int?
  evaluationMode CourseEvaluationMode
  status         StudentCourseAttemptStatus
  grade          Decimal?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  absences StudentAbsence[]

  @@unique([studentId, courseId, studyPeriodId])
  @@index([studentId, studyPeriodId])
  @@index([studentId, courseId])
  @@index([studentId, status])
  @@index([classId])
  @@schema("app")
}

model ProfessorEvaluation {
  id          Int       @id @default(autoincrement())
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId   Int
  class       Class     @relation(fields: [classId], references: [id])
  classId     Int
  professor   Professor @relation(fields: [professorId], references: [id])
  professorId Int

  wouldTakeAgain Int @db.SmallInt
  fairness       Int @db.SmallInt
  clarity        Int @db.SmallInt
  difficulty     Int @db.SmallInt

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, classId, professorId])
  @@index([classId, professorId])
  @@index([professorId])
  @@schema("app")
}

model StudentAbsence {
  id Int @id @default(autoincrement())

  studentCourseAttempt   StudentCourseAttempt @relation(fields: [studentCourseAttemptId], references: [id], onDelete: Cascade)
  studentCourseAttemptId Int

  classSchedule   ClassSchedule @relation(fields: [classScheduleId], references: [id])
  classScheduleId Int

  date DateTime @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentCourseAttemptId, classScheduleId, date])
  @@index([studentCourseAttemptId, date])
  @@index([classScheduleId, date])
  @@schema("app")
}

model Curriculum {
  id                      Int                    @id @default(autoincrement())
  student                 Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  studentId               Int
  name                    String                 @default("Novo planejamento")
  catalogProgram          CatalogProgram?        @relation(fields: [catalogProgramId], references: [id])
  catalogProgramId        Int?
  catalogProgramVariant   CatalogProgramVariant? @relation(fields: [catalogProgramVariantId], references: [id])
  catalogProgramVariantId Int?
  catalogLanguage         CatalogLanguage?       @relation(fields: [catalogLanguageId], references: [id])
  catalogLanguageId       Int?
  planningStartYear       Int?
  planningStartSemester   Int?
  planningStartNumber     Int?
  currentPeriod           CurriculumPeriod?      @relation("CurrentPeriod", fields: [currentPeriodId], references: [id], onDelete: SetNull)
  currentPeriodId         Int?
  periods                 CurriculumPeriod[]
  courses                 CurriculumCourse[]
  periodPlannings         PeriodPlanning[]
  favoriteForStudent      Student?               @relation("StudentFavoriteCurriculum")
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([studentId, updatedAt])
  @@schema("app")
}

model CurriculumCourse {
  curriculum   Curriculum        @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  curriculumId Int
  course       Course            @relation(fields: [courseId], references: [id])
  courseId     Int
  period       CurriculumPeriod? @relation(fields: [periodId], references: [id], onDelete: SetNull)
  periodId     Int?

  @@id([curriculumId, courseId])
  @@index([curriculumId, periodId])
  @@schema("app")
}

model CurriculumPeriod {
  id                  Int                @id @default(autoincrement())
  curriculum          Curriculum         @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  curriculumId        Int
  position            Int
  courses             CurriculumCourse[]
  currentForCurricula Curriculum[]       @relation("CurrentPeriod")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([curriculumId, position])
  @@schema("app")
}

model PeriodPlanning {
  id                      Int                             @id @default(autoincrement())
  name                    String                          @default("Novo planejamento de semestre")
  studyPeriod             StudyPeriod                     @relation(fields: [studyPeriodId], references: [id])
  studyPeriodId           Int
  student                 Student                         @relation(fields: [studentId], references: [id])
  studentId               Int
  curriculum              Curriculum?                     @relation(fields: [curriculumId], references: [id], onDelete: SetNull)
  curriculumId            Int?
  guideMode               PeriodPlanningGuideMode         @default(NONE)
  curriculumSource        PeriodPlanningCurriculumSource?
  curriculumSuggestion    CurriculumSuggestion?           @relation(fields: [curriculumSuggestionId], references: [id], onDelete: SetNull)
  curriculumSuggestionId  Int?
  catalogProgram          CatalogProgram?                 @relation(fields: [catalogProgramId], references: [id], onDelete: SetNull)
  catalogProgramId        Int?
  catalogProgramVariant   CatalogProgramVariant?          @relation(fields: [catalogProgramVariantId], references: [id], onDelete: SetNull)
  catalogProgramVariantId Int?
  language                Language?                       @relation(fields: [languageId], references: [id], onDelete: SetNull)
  languageId              Int?
  visibility              PeriodPlanningVisibility        @default(PRIVATE)
  shareId                 String                          @unique @default(dbgenerated("gen_random_uuid()"))
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt

  classes       Class[]
  manualCourses PeriodPlanningManualCourse[]

  @@index([studentId, updatedAt])
  @@index([curriculumId])
  @@index([curriculumSuggestionId])
  @@index([catalogProgramId])
  @@index([catalogProgramVariantId])
  @@index([languageId])
  @@index([visibility, studyPeriodId, updatedAt])
  @@schema("app")
}

model PeriodPlanningManualCourse {
  periodPlanning   PeriodPlanning @relation(fields: [periodPlanningId], references: [id], onDelete: Cascade)
  periodPlanningId Int
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId         Int
  createdAt        DateTime       @default(now())

  @@id([periodPlanningId, courseId])
  @@index([courseId])
  @@schema("app")
}

model CalendarEvent {
  id          Int           @id @default(autoincrement())
  startDate   DateTime
  endDate     DateTime?
  description String
  tags        CalendarTag[]

  @@index([startDate, endDate])
  @@schema("data")
}

model CalendarTag {
  id     Int             @id @default(autoincrement())
  name   String          @unique
  events CalendarEvent[]

  @@schema("data")
}
