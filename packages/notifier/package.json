{
    "name": "@pomi/notifier",
    "version": "1.0.0-rc.1",
    "private": true,
    "type": "module",
    "imports": {
        "#/*": {
            "development": "./src/*",
            "default": "./dist/src/*"
        }
    },
    "scripts": {
        "dev": "NODE_OPTIONS=--conditions=development tsx --import @pomi/api-core/telemetry/bootstrap watch src/cli.ts",
        "build": "tsc -b",
        "start": "node --import @pomi/api-core/telemetry/bootstrap dist/src/cli.js",
        "pomi-notifier": "NODE_OPTIONS=--conditions=development tsx --import @pomi/api-core/telemetry/bootstrap src/cli.ts",
        "test": "NODE_OPTIONS=--conditions=development tsx --test test/**/*.test.ts"
    },
    "dependencies": {
        "@pomi/api-core": "*",
        "@pomi/db": "*",
        "dotenv": "^17.2.3",
        "jose": "^6.1.3",
        "nodemailer": "^7.0.10",
        "pino": "^10.3.1",
        "zod": "^4.2.1"
    },
    "devDependencies": {
        "@types/nodemailer": "^6.4.19"
    }
}
