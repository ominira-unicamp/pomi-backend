{
    "version": 1,
    "rootDirectory": "../..",
    "injections": [
        {
            "name": "academic-data",
            "description": "Dados acadêmicos",
            "schedule": { "cron": "0 4 * * *" },
            "partitioning": { "kind": "period-institute", "firstYear": 2018 },
            "obtain": {
                "command": "<obtain-command>",
                "args": [],
                "cwd": ".",
                "env": {},
                "timeoutMs": 3600000
            },
            "input": {
                "directory": "data/injections/academic-data",
                "fileName": "academic-data.json"
            },
            "options": { "databaseConcurrency": 8 }
        },
        {
            "name": "calendar",
            "description": "Calendário acadêmico",
            "schedule": { "cron": "0 5 * * *" },
            "obtain": {
                "command": "<obtain-command>",
                "args": [],
                "cwd": ".",
                "env": {},
                "timeoutMs": 1800000
            },
            "input": {
                "directory": "data/injections/calendar",
                "fileName": "calendario.json"
            },
            "options": {
                "transactionTimeout": 600000,
                "transactionMaxWait": 60000
            }
        },
        {
            "name": "catalogs",
            "description": "Catálogos e currículos",
            "obtain": {
                "command": "node",
                "args": [
                    "unicamp-scrapper-cli/dist/index.js",
                    "catalogo-curriculos",
                    "--first-year",
                    "2021",
                    "--last-year",
                    "${POMI_CURRENT_YEAR}",
                    "--output",
                    "${POMI_INJECTION_OUTPUT}",
                    "--concurrency",
                    "1"
                ],
                "cwd": "../scrapper-aulas",
                "env": {},
                "timeoutMs": 7200000
            },
            "input": {
                "directory": "data/injections/catalogs",
                "fileName": "catalogs.json"
            },
            "allowIssues": true,
            "partitioning": { "kind": "year", "firstYear": 2021 },
            "options": {
                "transactionTimeout": 600000,
                "transactionMaxWait": 60000
            }
        },
        {
            "name": "catalog-disciplines",
            "description": "Disciplinas e relações do catálogo",
            "schedule": { "cron": "0 2 1 * *" },
            "obtain": {
                "command": "<obtain-command>",
                "args": [],
                "cwd": ".",
                "env": {},
                "timeoutMs": 3600000
            },
            "input": {
                "directory": "data/injections/catalog-disciplines",
                "fileName": "catalog-disciplines.json"
            },
            "options": {
                "phase": "all",
                "transactionTimeout": 1800000,
                "transactionMaxWait": 60000
            }
        },
        {
            "name": "catalog-information",
            "description": "Informações estruturadas dos programas dos catálogos",
            "schedule": { "cron": "0 4 1 * *" },
            "obtain": {
                "command": "node",
                "args": [
                    "unicamp-scrapper-cli/dist/index.js",
                    "catalogo-informacoes",
                    "--first-year",
                    "1998",
                    "--last-year",
                    "${POMI_CURRENT_YEAR}",
                    "--output",
                    "${POMI_INJECTION_OUTPUT}",
                    "--concurrency",
                    "1"
                ],
                "cwd": "../scrapper-aulas",
                "env": {},
                "timeoutMs": 7200000
            },
            "input": {
                "directory": "data/injections/catalog-information",
                "fileName": "catalog-information.json"
            },
            "allowIssues": true,
            "options": {
                "transactionTimeout": 600000,
                "transactionMaxWait": 60000
            }
        },
        {
            "name": "daily-menus",
            "description": "Cardápios dos restaurantes universitários",
            "schedule": { "cron": "0 */6 * * *" },
            "obtain": {
                "command": "node",
                "args": [
                    "unicamp-scrapper-cli/dist/index.js",
                    "cardapios",
                    "--past-days",
                    "1",
                    "--future-days",
                    "7",
                    "--output",
                    "${POMI_INJECTION_OUTPUT}"
                ],
                "cwd": "../scrapper-aulas",
                "env": {},
                "timeoutMs": 300000
            },
            "input": {
                "directory": "data/injections/daily-menus",
                "fileName": "daily-menus.json"
            },
            "allowIssues": true,
            "options": {
                "transactionTimeout": 60000,
                "transactionMaxWait": 10000
            }
        },
        {
            "name": "historical-programs",
            "description": "Programas e vínculos com catálogos históricos",
            "schedule": { "cron": "0 3 1 * *" },
            "obtain": {
                "command": "node",
                "args": [
                    "unicamp-scrapper-cli/dist/index.js",
                    "catalogos-programas",
                    "--first-year",
                    "1998",
                    "--last-year",
                    "2020",
                    "--output",
                    "${POMI_INJECTION_OUTPUT}"
                ],
                "cwd": "../scrapper-aulas",
                "env": {},
                "timeoutMs": 7200000
            },
            "input": {
                "directory": "data/injections/historical-programs",
                "fileName": "historical-programs.json"
            },
            "allowIssues": true,
            "options": {
                "transactionTimeout": 600000,
                "transactionMaxWait": 60000
            }
        },
        {
            "name": "suggestions",
            "description": "Sugestões de currículo",
            "obtain": {
                "command": "node",
                "args": [
                    "unicamp-scrapper-cli/dist/index.js",
                    "sugestao-curriculo",
                    "--first-year",
                    "2021",
                    "--last-year",
                    "${POMI_CURRENT_YEAR}",
                    "--output",
                    "${POMI_INJECTION_OUTPUT}",
                    "--concurrency",
                    "1"
                ],
                "cwd": "../scrapper-aulas",
                "env": {},
                "timeoutMs": 7200000
            },
            "input": {
                "directory": "data/injections/suggestions",
                "fileName": "suggestions.json"
            },
            "allowIssues": true,
            "partitioning": { "kind": "year", "firstYear": 2021 },
            "options": {
                "concurrency": 4,
                "transactionTimeout": 120000,
                "transactionMaxWait": 60000
            }
        },
        {
            "name": "exchange-notices",
            "description": "Editais de intercâmbio da DERI",
            "schedule": { "cron": "30 */6 * * *" },
            "obtain": {
                "command": "node",
                "args": [
                    "unicamp-scrapper-cli/dist/index.js",
                    "editais-intercambio",
                    "--output",
                    "${POMI_INJECTION_OUTPUT}"
                ],
                "cwd": "../scrapper-aulas",
                "env": {},
                "timeoutMs": 300000
            },
            "input": {
                "directory": "data/injections/exchange-notices",
                "fileName": "exchange-notices.json"
            },
            "allowIssues": true,
            "options": {
                "transactionTimeout": 60000,
                "transactionMaxWait": 10000
            }
        },
        {
            "name": "professors-data-portal",
            "description": "Perfis de professores do Portal de Dados da Unicamp",
            "schedule": { "cron": "0 4 * * 1" },
            "obtain": {
                "command": "pomi-scraper",
                "args": [
                    "professors-data-portal",
                    "--output",
                    "${POMI_INJECTION_OUTPUT}",
                    "--concurrency",
                    "24",
                    "--page-concurrency",
                    "8",
                    "--request-interval-ms",
                    "0"
                ],
                "cwd": ".",
                "env": {},
                "timeoutMs": 7200000
            },
            "input": {
                "directory": "data/injections/professors-data-portal",
                "fileName": "professors-data-portal.json"
            },
            "allowIssues": true,
            "options": {
                "databaseConcurrency": 4,
                "transactionTimeout": 600000,
                "transactionMaxWait": 60000
            }
        }
    ]
}
